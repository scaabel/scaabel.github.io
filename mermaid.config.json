    "signalColor": "#687988",
    "signalTextColor": "#e8eef2",
    "noteBkgColor": "#111e2d",
    "noteBorderColor": "#355477",
    "noteTextColor": "#e8eef2",
    "labelBoxBkgColor": "#07111c",
    "labelBoxBorderColor": "#355477",
